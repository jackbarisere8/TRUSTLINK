import { createHash } from "node:crypto";
import { readFile, writeFile } from "node:fs/promises";
import path from "node:path";

type SourceFeature = {
  properties: {
    admin2Name: string;
    admin2Pcod: string;
    admin1Name: string;
    admin1Pcod: string;
    admin0Pcod: string;
    validOn: string;
  };
};

type SourceCollection = { type: "FeatureCollection"; features: SourceFeature[] };

const sourceArgument = process.argv.slice(2).find(argument => !argument.startsWith("--"));
const retrievedAt = process.argv.find(argument => argument.startsWith("--retrieved-at="))?.split("=")[1] ?? new Date().toISOString().slice(0, 10);

if (!sourceArgument) {
  throw new Error("Usage: node --import tsx scripts/import-nigeria-admin-data.mts <ADM2 GeoJSON> [--retrieved-at=YYYY-MM-DD]");
}

const raw = await readFile(path.resolve(sourceArgument), "utf8");
// The World Bank download currently appends a diagnostic string after the
// GeoJSON document. Hash and parse the complete valid JSON object only.
const lastBrace = raw.lastIndexOf("}");
if (lastBrace < 0) throw new Error("The source does not contain a JSON object.");
const sourceJson = raw.slice(0, lastBrace + 1);
const source = JSON.parse(sourceJson) as SourceCollection;
if (source.type !== "FeatureCollection" || !Array.isArray(source.features)) throw new Error("Expected a GeoJSON FeatureCollection.");

const states = [...new Map(source.features.map(feature => {
  const value = feature.properties;
  return [value.admin1Pcod, {
    code: value.admin1Pcod,
    name: value.admin1Name,
    kind: value.admin1Pcod === "NG015" ? "FCT" : "STATE",
  }];
})).values()].sort((left, right) => left.code.localeCompare(right.code));

const lgas = source.features.map(feature => {
  const value = feature.properties;
  if (value.admin0Pcod !== "NG") throw new Error(`Unexpected country code for ${value.admin2Pcod}.`);
  return {
    code: value.admin2Pcod,
    stateCode: value.admin1Pcod,
    name: value.admin2Name,
    kind: value.admin1Pcod === "NG015" ? "AREA_COUNCIL" : "LGA",
  };
}).sort((left, right) => left.code.localeCompare(right.code));

if (states.length !== 37) throw new Error(`Expected 37 state/FCT units; found ${states.length}.`);
if (lgas.length !== 774) throw new Error(`Expected 774 LGA/area-council units; found ${lgas.length}.`);
if (new Set(states.map(state => state.code)).size !== states.length || new Set(lgas.map(lga => lga.code)).size !== lgas.length) {
  throw new Error("Administrative codes must be unique.");
}
if (lgas.filter(lga => lga.kind === "AREA_COUNCIL").length !== 6) throw new Error("Expected six FCT area councils.");
if (lgas.some(lga => !states.some(state => state.code === lga.stateCode))) throw new Error("Every LGA must reference an imported state.");

const sha256 = (value: string) => createHash("sha256").update(value).digest("hex");
const normalizedPayload = JSON.stringify({ states, lgas });
const metadata = {
  id: "ocha-osgof-nga-adm-2017",
  title: "Nigeria administrative boundaries (ADM1/ADM2)",
  publisher: "Office of the Surveyor-General of the Federation (OSGOF), distributed by OCHA HDX",
  landingPage: "https://data.humdata.org/dataset/nga-administrative-boundaries",
  downloadUrl: "https://datacatalogfiles.worldbank.org/ddh-published-v2/0039368/1/DR0048906/ngaadmbndaadm2osgof20170222.geojson",
  license: "CC-BY-4.0",
  sourceValidOn: source.features[0]?.properties.validOn ?? "2017/02/22",
  retrievedAt,
  sourceSha256: sha256(sourceJson),
  normalizedSha256: sha256(normalizedPayload),
  stateCount: states.length,
  lgaCount: lgas.length,
};

const artifact = JSON.stringify({ metadata, states, lgas }, null, 2) + "\n";
await writeFile(path.join(process.cwd(), "data", "nigeria-administrative-areas.json"), artifact, "utf8");

const literal = (value: string) => `'${value.replaceAll("'", "''")}'`;
const stateValues = states.map(state => `  (${literal(state.code)},${literal(state.name)},${literal(state.kind)},${literal(metadata.id)})`).join(",\n");
const lgaValues = lgas.map(lga => `  (${literal(lga.code)},${literal(lga.stateCode)},${literal(lga.name)},${literal(lga.kind)},${literal(metadata.id)})`).join(",\n");
const seed = `-- Generated by scripts/import-nigeria-admin-data.mts. Do not hand-edit.\nBEGIN;\n\nINSERT INTO public.reference_data_releases(\n  id,title,publisher,landing_page,download_url,license,source_valid_on,retrieved_at,source_sha256,normalized_sha256,state_count,lga_count\n) VALUES (\n  ${literal(metadata.id)},${literal(metadata.title)},${literal(metadata.publisher)},${literal(metadata.landingPage)},\n  ${literal(metadata.downloadUrl)},${literal(metadata.license)},${literal(metadata.sourceValidOn)},${literal(metadata.retrievedAt)},\n  ${literal(metadata.sourceSha256)},${literal(metadata.normalizedSha256)},${metadata.stateCount},${metadata.lgaCount}\n);\n\nINSERT INTO public.nigeria_states(code,name,kind,release_id) VALUES\n${stateValues};\n\nINSERT INTO public.nigeria_lgas(code,state_code,name,kind,release_id) VALUES\n${lgaValues};\n\nDO $$\nBEGIN\n  IF (SELECT count(*) FROM public.nigeria_states WHERE release_id=${literal(metadata.id)})<>37 OR\n     (SELECT count(*) FROM public.nigeria_lgas WHERE release_id=${literal(metadata.id)})<>774 OR\n     (SELECT count(*) FROM public.nigeria_lgas WHERE release_id=${literal(metadata.id)} AND kind='AREA_COUNCIL')<>6 THEN\n    RAISE EXCEPTION 'Nigeria administrative reference import failed its integrity counts';\n  END IF;\nEND $$;\n\nCOMMIT;\n`;
await writeFile(path.join(process.cwd(), "supabase", "migrations", "20261005000001_nigeria_admin_seed.sql"), seed, "utf8");

process.stdout.write(`Imported ${states.length} state/FCT and ${lgas.length} LGA/area-council records.\n`);
process.stdout.write(`Source SHA-256: ${metadata.sourceSha256}\nNormalized SHA-256: ${metadata.normalizedSha256}\n`);
