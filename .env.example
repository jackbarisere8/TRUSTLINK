# Copy to .env.local. Never commit credentials or paste them into chat.
# Local storage is development-only; production fails closed without Supabase.
TRUSTLINK_STORAGE=local

# Set TRUSTLINK_STORAGE=supabase for authenticated development/staging/production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only credential. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment credentials are not used: payments are participant reports only.
